{
  "name": "agent-cms",
  "version": "0.4.5",
  "description": "Agent-first headless CMS for Cloudflare Workers. Schema, content, and assets via MCP. GraphQL delivery.",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./lib": {
      "types": "./dist/lib.d.mts",
      "import": "./src/lib.ts"
    }
  },
  "files": [
    "dist/*.mjs",
    "dist/*.mts",
    "migrations",
    "README.md",
    "PROMPT.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "oxlint --type-check src/",
    "typecheck": "tsc --noEmit",
    "bench:blog": "node scripts/bench-blog.mjs",
    "eval:structured-text": "node scripts/structured-text-agent-eval.mjs",
    "dato:import": "node scripts/dato-import/cli.mjs",
    "prepublishOnly": "pnpm run build",
    "prepare": "effect-language-service patch"
  },
  "keywords": [
    "cms",
    "headless-cms",
    "mcp",
    "cloudflare-workers",
    "d1",
    "graphql",
    "agent",
    "ai"
  ],
  "author": "Jokull Solberg <jokull@solberg.is>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jokull/agent-cms.git"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "workerd"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1014.0",
    "@aws-sdk/s3-request-presigner": "^3.1014.0",
    "@cloudflare/codemode": "^0.3.2",
    "@datocms/cma-client-node": "^5.4.18",
    "@effect/platform-node": "4.0.0-rc.109",
    "@effect/sql-d1": "4.0.0-rc.109",
    "agents": "^0.8.6",
    "datocms-structured-text-dastdown": "^5.1.16",
    "datocms-structured-text-to-plain-text": "^5.1.16",
    "datocms-structured-text-utils": "^5.1.16",
    "effect": "4.0.0-rc.109",
    "graphql": "^16.13.1",
    "graphql-yoga": "^5.18.1",
    "nanoid": "^5.1.7",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "slugify": "^1.6.8",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@agent-cms/dast": "workspace:*",
    "@cloudflare/workers-types": "^4.20260317.1",
    "@effect/language-service": "^0.87.2",
    "@effect/sql-sqlite-node": "4.0.0-rc.109",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@oxlint/plugins": "1.78.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mdast": "^4.0.4",
    "better-sqlite3": "^12.8.0",
    "miniflare": "^4.20260317.1",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.76.0"
  }
}
