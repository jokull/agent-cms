{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@agent-cms/codegen/errors": [
        "./src/errors.ts"
      ],
      "@agent-cms/codegen/server-runtime": [
        "./src/server-runtime.ts"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "test",
    "example"
  ],
  "exclude": [
    "test/real-schema.test.ts",
    "test/e2e.test.ts",
    "test/__generated__"
  ]
}
