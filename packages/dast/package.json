{
  "name": "@agent-cms/dast",
  "version": "0.1.0",
  "description": "DAST (DatoCMS Abstract Syntax Tree) node types and grammar constants. Zero runtime dependencies — the single source of truth shared by agent-cms, the block editor, and generated clients.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "dast",
    "structured-text",
    "datocms",
    "agent-cms"
  ],
  "author": "Jokull Solberg <jokull@solberg.is>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jokull/agent-cms.git",
    "directory": "packages/dast"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
